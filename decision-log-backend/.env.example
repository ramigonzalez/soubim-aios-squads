# Database
DATABASE_URL=postgresql://user:password@localhost:5432/decisionlog

# JWT
JWT_SECRET_KEY=your-secret-key-here-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Tactiq Webhook
TACTIQ_WEBHOOK_SECRET=whsec_your-webhook-secret

# Sentry
SENTRY_DSN=https://your-sentry-dsn

# Environment
ENVIRONMENT=development
DEBUG=true

# Demo Mode (SECURITY: Set to false in production!)
# When true, allows seeding database with test users (password: "password")
DEMO_MODE=true

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Recording storage, S3-compatible (Story 13.1) - optional; unset = recordings stay on local disk.
# Dev: SeaweedFS from docker-compose (http://127.0.0.1:9000). Prod: Cloudflare R2 / Backblaze B2.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=decisionlog-recordings-dev
# RECORDING_MAX_BYTES=2147483648

# Fathom OAuth (Story 13.3) - optional; unset = "Conectar ao Fathom" is disabled.
# FATHOM_REDIRECT_URI must equal the redirect URL registered in the Fathom app (HTTPS; dev uses ngrok).
# FATHOM_CLIENT_ID=
# FATHOM_CLIENT_SECRET=
# FATHOM_REDIRECT_URI=https://<ngrok-domain>/api/fathom/callback
# Fernet key that encrypts stored Fathom tokens:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
# Where the OAuth callback sends the browser back (frontend base URL)
# FRONTEND_URL=http://localhost:5173
