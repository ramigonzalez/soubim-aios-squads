# Copy to .env.development (gitignored) and fill in. Never commit real values.
# Variable names are everything the app reads (app/config.py, worker, seeds).

# --- Database (Postgres with pgvector; local: docker compose up -d db) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisionlog_dev

# --- Auth ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (>= 32 chars)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# --- LLM (Story 7.11) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-opus-5-5
EXTRACTION_MAX_TOKENS=64000
EXTRACTION_EFFORT=high

# --- Webhooks ---
TACTIQ_WEBHOOK_SECRET=change-me

# --- Fathom OAuth (Epic 13; read once 13.3 lands) ---
FATHOM_CLIENT_ID=
FATHOM_CLIENT_SECRET=
FATHOM_REDIRECT_URI=http://localhost:8000/api/integrations/fathom/callback

# --- Object storage for recordings (Story 13.1; provider TBD) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Runtime ---
# development/test: create_all + demo seeding. Anything else (production): Alembic only, no seeding.
ENVIRONMENT=development
DEBUG=true
# Seeds demo users (password "password"). NEVER true in production.
DEMO_MODE=true
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
WORKER_POLL_SECONDS=2

# --- Optional ---
SENTRY_DSN=
GMAIL_CREDENTIALS_JSON=
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=
CURATION_SYNC_ENABLED=false
