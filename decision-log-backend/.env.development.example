# Copy to .env.development (gitignored) and fill in. Never commit real values.
# Variable names are everything the app reads (app/config.py, worker, seeds).

# --- Database (Postgres with pgvector; local: docker compose up -d db) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisionlog_dev

# --- Auth ---
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (>= 32 chars)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# --- LLM (Story 7.11) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-opus-5-5
EXTRACTION_MAX_TOKENS=64000
EXTRACTION_EFFORT=high

# --- Webhooks ---
TACTIQ_WEBHOOK_SECRET=change-me

# --- Fathom OAuth (Story 13.3) ---
# Redirect must be HTTPS and registered in the Fathom app: dev uses ngrok forwarding to port 8000.
FATHOM_CLIENT_ID=
FATHOM_CLIENT_SECRET=
FATHOM_REDIRECT_URI=https://naturally-ethical-shark.ngrok-free.app/api/fathom/callback
# Fernet key for stored tokens: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# --- Sign in with Google (Story 12.8) --- empty = button hidden
# Google accepts http://localhost redirects; use the ngrok one to test through the tunnel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Object storage for recordings (Story 13.1; provider TBD) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Runtime ---
# development/test: create_all + demo seeding. Anything else (production): Alembic only, no seeding.
ENVIRONMENT=development
DEBUG=true
# Seeds demo users (password "password"). NEVER true in production.
DEMO_MODE=true
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
WORKER_POLL_SECONDS=2

# --- Rate limiting (Story 13.11) ---
# Off switch (the test suite sets it to false). Limits are "N/minute" | "N/hour" strings.
RATE_LIMIT_ENABLED=true
# Empty = in-memory (per instance). Set redis://... to share limits across instances (production, >1 API instance).
RATE_LIMIT_STORAGE_URI=
# true ONLY behind a proxy you control (Railway): honours X-Forwarded-For, TRUSTED_PROXY_HOPS entries from the right.
TRUSTED_PROXY=false
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_LOGIN_IP=30/minute
RATE_LIMIT_LOGIN_EMAIL_MINUTE=5/minute
RATE_LIMIT_LOGIN_EMAIL_HOUR=20/hour
RATE_LIMIT_INVITATION=10/minute
RATE_LIMIT_OAUTH_CALLBACK=20/minute
RATE_LIMIT_WEBHOOK=120/minute
RATE_LIMIT_PUBLIC_LINK=60/minute
RATE_LIMIT_DEFAULT=600/minute

# --- Optional ---
SENTRY_DSN=
GMAIL_CREDENTIALS_JSON=
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=
CURATION_SYNC_ENABLED=false
